# ============================================================================
# generate-example-clinic — Plantilla de configuración LOCAL
# ============================================================================
# Este archivo es una plantilla para desarrollo local. Cópialo a `.env`
# (que está gitignoreado) y rellena con tus credenciales personales de
# sandbox. NO commitees `.env` nunca.
#
# En staging/producción, las credenciales de canal (Meta, Google) NO viven
# aquí: cada clínica las inserta en caliente desde el dashboard y se cifran
# en la tabla `channel_credentials` (RNF-003). Los secretos de plataforma
# (ENCRYPTION_KEY, DATABASE_URL, etc.) viven en Infisical.
#
#   Infisical: https://app.infisical.com
#   Proyecto:  GAVANTI / puntual
#   Entornos:  development | staging | production
# ============================================================================

# ============================================================================
# ENCRYPTION_KEY — Clave maestra AES-256-GCM (mínimo 32 caracteres)
# ============================================================================
# Debe ser LA MISMA que usa la API para cifrar/descifrar credenciales de canal.
#
# Local:       cópiala del .env raíz del monorepo (o del .env local de apps/api)
# Staging:     Infisical → proyecto `puntual` → entorno `staging` → ENCRYPTION_KEY
# Production:  Infisical → proyecto `puntual` → entorno `production` → ENCRYPTION_KEY
#
# Si la cambias aquí y no en la API (o viceversa), los secretos cifrados
# por el seed no podrán descifrarse al vuelo por ChannelsService.
ENCRYPTION_KEY=

# ============================================================================
# DATABASE_URL — Base de datos local de desarrollo
# ============================================================================
# Debe apuntar a la misma DB local que usa la API cuando corres `pnpm dev`.
# En staging/producción, esta variable se resuelve vía Infisical.
DATABASE_URL=postgresql://puntual_dev:CHANGE_ME@localhost:5434/puntual_dev?schema=public

# ============================================================================
# CLÍNICA DE PRUEBA — Identidad del tenant que se va a crear
# ============================================================================
# Estos son datos ficticios. Cámbialos solo si necesitas distinguir varias
# clínicas de prueba simultáneas.
TEST_CLINIC_ID=test-clinic-sandbox
TEST_CLINIC_NAME=Clínica Sandbox Local
TEST_CLINIC_EMAIL=sandbox@example.local
TEST_CLINIC_PHONE=+00000000000

# ============================================================================
# DOCTOR DE PRUEBA — Profesional que atenderá las citas del sandbox
# ============================================================================
TEST_DOCTOR_NAME=Dr. Sandbox Local
TEST_DOCTOR_EMAIL=doctor.sandbox@example.local

# ============================================================================
# META WHATSAPP SANDBOX — Credenciales de Meta for Developers
# ============================================================================
# Obtén estos valores en: https://developers.facebook.com/apps
#   → tu app → Productos → WhatsApp → API Setup
#
# ⚠️ El ACCESS_TOKEN caduca en 24h si es temporal. Para tokens de larga
#    duración necesitas generar un System User Token en el Business Manager.
#
# ⚠️ NO commitees valores reales. Este archivo es la PLANTILLA.
META_SANDBOX_PHONE_NUMBER_ID=
META_SANDBOX_BUSINESS_ACCOUNT_ID=
META_SANDBOX_ACCESS_TOKEN=
META_SANDBOX_APP_SECRET=
META_SANDBOX_VERIFY_TOKEN=change-me-to-a-random-string

# Tu número personal de WhatsApp (Ecuador, formato E.164 sin +).
# Lo usas como destinatario de los mensajes del sandbox para probar el bot.
# Ejemplo de formato: 593XXXXXXXXX (no pongas un número real en este archivo).
META_SANDBOX_TEST_RECIPIENT=

# ============================================================================
# GOOGLE CALENDAR SANDBOX (OPCIONAL)
# ============================================================================
# Si dejas estos campos vacíos, el doctor de prueba se creará sin calendario.
# Útil para probar el flujo sin necesitar un proyecto GCP.
GOOGLE_TEST_CALENDAR_ID=
GOOGLE_TEST_REFRESH_TOKEN_CIPHER=

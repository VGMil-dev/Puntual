# Local Development Environment Template
PORT=3000
NODE_ENV=development

# PostgreSQL (Local Docker)
POSTGRES_USER=puntual_dev
POSTGRES_PASSWORD=puntual_dev_pass
POSTGRES_DB=puntual_dev
POSTGRES_PORT=5434
DATABASE_URL=postgresql://puntual_dev:puntual_dev_pass@localhost:5434/puntual_dev?schema=public

# Redis (Local Docker)
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# Infisical (Optional in local dev, fallback to .env)
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_ENVIRONMENT=development

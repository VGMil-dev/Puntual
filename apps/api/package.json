    "@nestjs/terminus": "^11.0.0",
    "@prisma/client": "^6.4.1",
    "ai": "^7.0.99",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "googleapis": "^180.0.0",

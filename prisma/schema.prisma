datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionStatus {
  TRIAL
  PAYMENT_PENDING
  ACTIVE
  SUSPENDED
}

enum PlanType {
  TRIAL
  BASIC
  PRO
}

enum ChannelType {
  WHATSAPP
  TELEGRAM
}

enum UserRole {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
}

enum AppointmentStatus {
  SOLICITADA
  CONFIRMADA
  COMPLETADA
  CANCELADA
  NO_SHOW
  EXPIRADA
}

model Clinic {
  id                         String             @id @default(uuid())
  name                       String
  slug                       String             @unique
  subscriptionStatus         SubscriptionStatus @default(TRIAL)
  trialEndsAt                DateTime?
  gracePeriodDays            Int                @default(5)
  whatsappPhoneNumberId      String?            @unique
  telegramBotTokenHash       String?
  googleCalendarId           String?
  defaultSlotDurationMinutes Int                @default(30)
  maxConcurrentHolds         Int                @default(3)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  users                      User[]
  doctors                    Doctor[]
  patients                   Patient[]
  appointments               Appointment[]
  subscription               Subscription?
  specialties                Specialty[]
  doctorSchedules            DoctorSchedule[]
  channelCredentials        ChannelCredential[]
  operationalLogs            OperationalLog[]
  conversations              Conversation[]
  scheduledJobs              ScheduledJob[]

  @@map("clinics")
}

model Subscription {
  id               String             @id @default(uuid())
  clinicId         String             @unique
  planType         PlanType           @default(TRIAL)
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  gracePeriodDays  Int                @default(5)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  clinic           Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model User {
  id                     String         @id @default(uuid())
  clinicId               String?
  email                  String         @unique
  passwordHash           String
  name                   String
  role                   UserRole       @default(CLINIC_ADMIN)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  clinic                 Clinic?        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor                 Doctor?
  refreshTokens          RefreshToken[]

  @@index([clinicId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Doctor {
  id                            String            @id @default(uuid())
  clinicId                      String
  userId                        String?           @unique
  name                          String
  email                         String?
  specialties                   String[]          @default([])
  googleCalendarId              String?
  googleRefreshTokenCipher      String?
  googleCalendarWriteVerifiedAt DateTime?
  slotDurationMinutes           Int?
  maxConcurrentHolds            Int?
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  clinic                        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user                          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments                  Appointment[]
  doctorSpecialties             DoctorSpecialty[]
  schedules                     DoctorSchedule[]

  @@index([clinicId])
  @@map("doctors")
}

model Specialty {
  id                         String            @id @default(uuid())
  clinicId                   String
  name                       String
  defaultSlotDurationMinutes Int               @default(30)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  clinic                     Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorSpecialties          DoctorSpecialty[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("specialties")
}

model DoctorSpecialty {
  id          String    @id @default(uuid())
  doctorId    String
  specialtyId String
  createdAt   DateTime  @default(now())

  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([doctorId, specialtyId])
  @@map("doctor_specialties")
}

model DoctorSchedule {
  id                  String   @id @default(uuid())
  clinicId            String
  doctorId            String
  dayOfWeek           Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime           String   // "HH:mm", e.g. "09:00"
  endTime             String   // "HH:mm", e.g. "18:00"
  slotDurationMinutes Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([doctorId])
  @@map("doctor_schedules")
}

model ChannelCredential {
  id             String      @id @default(uuid())
  clinicId       String
  channelType    ChannelType
  identifier     String      // phone_number_id for WhatsApp, bot_username for Telegram
  encryptedToken String
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  clinic         Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([channelType, identifier])
  @@index([clinicId])
  @@map("channel_credentials")
}

model OperationalLog {
  id             String   @id @default(uuid())
  traceId        String
  clinicId       String?
  conversationId String?
  level          String   // "info", "warn", "error"
  category       String   // "auth", "channel_gateway", "ai", "calendar"
  message        String
  metadata       Json?
  latencyMs      Int?
  createdAt      DateTime @default(now())

  clinic         Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([traceId])
  @@index([clinicId])
  @@index([category, createdAt])
  @@map("operational_logs")
}

model Patient {
  id             String        @id @default(uuid())
  clinicId       String
  name           String
  phone          String
  telegramChatId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  conversations  Conversation[]

  @@unique([clinicId, phone])
  @@index([clinicId])
  @@map("patients")
}

model Appointment {
  id                    String            @id @default(uuid())
  clinicId              String
  doctorId              String
  patientId             String
  conversationId        String?
  status                AppointmentStatus @default(SOLICITADA)
  startAt               DateTime
  endAt                 DateTime
  reason                String?
  googleCalendarEventId String?
  holdExpiresAt         DateTime?
  reconfirmationSentAt  DateTime?
  reconfirmedAt         DateTime?
  surveySentAt          DateTime?
  surveyRating          Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  clinic                Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor                Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient               Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([clinicId, status])
  @@index([clinicId, startAt])
  @@index([doctorId, startAt])
  @@index([clinicId, conversationId])
  @@map("appointments")
}

enum ConversationStatus {
  ACTIVA
  ESCALADA
  RESUELTA
  CERRADA
}

model Conversation {
  id              String             @id @default(uuid())
  clinicId        String
  patientId       String?
  channelType     ChannelType
  channelThreadId String
  status          ConversationStatus @default(ACTIVA)
  lastActivityAt  DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([clinicId, channelType, channelThreadId])
  @@index([clinicId, status])
  @@map("conversations")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ScheduledJob {
  id             String    @id @default(uuid())
  clinicId       String
  type           String    // "expiracion_hold", "calendar_sync", "reconfirmacion", etc.
  entityId       String    // e.g. appointmentId
  executionDate  String    // YYYY-MM-DD
  status         JobStatus @default(PENDING)
  idempotencyKey String    @unique // tipo:clinicaId:entidadId:fechaEjecucion
  attempts       Int       @default(0)
  nextRetryAt    DateTime?
  payload        Json?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  clinic         Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
  @@index([type, status])
  @@index([type, status, nextRetryAt])
  @@map("scheduled_jobs")
}

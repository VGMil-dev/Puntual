# Staging Environment Template (Never commit actual credentials to Git)
PORT=3000
NODE_ENV=staging

# PostgreSQL Staging (Different DB, user and ports/volumes from local dev)
POSTGRES_USER=puntual_staging
POSTGRES_PASSWORD=change_me_in_staging_secrets
POSTGRES_DB=puntual_staging
POSTGRES_PORT=5433
DATABASE_URL=postgresql://puntual_staging:change_me_in_staging_secrets@localhost:5433/puntual_staging?schema=public

# Redis Staging (Different port and password/volume)
REDIS_PORT=6380
REDIS_PASSWORD=change_me_redis_staging_secret
REDIS_URL=redis://:change_me_redis_staging_secret@localhost:6380

# Infisical Cloud (Required for Staging runtime)
INFISICAL_PROJECT_ID=change_me_project_id
INFISICAL_CLIENT_ID=change_me_client_id
INFISICAL_CLIENT_SECRET=change_me_client_secret
INFISICAL_ENVIRONMENT=staging

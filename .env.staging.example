# Variables para el .env de staging en el servidor (~/puntual-staging/.env)
# Copia este archivo como .env EN EL SERVIDOR y rellena los valores.
# NO COMMITEES el .env real.

NODE_ENV=staging
PORT=3000

# Postgres (valores consumidos por docker-compose.staging.yml)
POSTGRES_USER=puntual_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=puntual_staging

# Redis no requiere password en esta versión (solo red interna Docker)

# Secretos de aplicación (generar nuevos para staging)
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# Integraciones (opcionales según alcance del piloto)
# META_APP_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
